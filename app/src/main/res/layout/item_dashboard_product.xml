<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    tools:ignore="Orientation">

    <LinearLayout
        android:id="@+id/fragment_container"
        android:orientation="horizontal"
        android:background="@drawable/product_corner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="4dp"
        android:gravity="center_vertical"
        tools:ignore="MissingConstraints">



        <ImageView
            android:id="@+id/dash_productImage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/logo"
            android:background="@android:color/darker_gray"
            android:scaleType="centerCrop"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/dash_productName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="chocho"
            android:textColor="#888888"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/sold_quantity"
            android:layout_width="100dp"
            android:layout_height="17dp"
            android:layout_marginLeft="30dp"

            android:text="Quantity: 20" />

        <TextView
            android:id="@+id/dash_total_Price_sold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginRight="20dp"
            android:layout_marginLeft="20dp"
            android:text="Total Price: " />

    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/edit_fragment_container"
        tools:ignore="DuplicateIds">

    </FrameLayout>

</LinearLayout>