<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="400dp"
    android:layout_height="match_parent"
    android:backgroundTint="#D4E24E">
    <!-- res/layout/dialog_add_product.xml -->
    <LinearLayout
        android:layout_width="358dp"
        android:layout_height="548dp"
        android:background="@drawable/rounded_dialog_bg"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/edit_to_inventory"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/ic_back"
            android:clickable="true"
            android:contentDescription="@string/action_sign_in_short"
            android:translationX="@dimen/cardview_compat_inset_shadow"
            tools:ignore="TouchTargetSizeCheck">

        </ImageView>

        <EditText
            android:id="@+id/editname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:hint="Product Name"
            android:minHeight="48dp"
            android:padding="10dp" />

        <EditText
            android:id="@+id/editprice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:hint="Product Price"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/editquantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:hint="Total Quantity"
            android:inputType="number"
            android:minHeight="48dp" />


        <Button
            android:id="@+id/btneditItem"
            android:layout_width="170dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="140dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/rounded_corner"
            android:backgroundTint="#CF3434"
            android:minHeight="48dp"
            android:text="Save"
            android:textColor="#FAFAFA" />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>