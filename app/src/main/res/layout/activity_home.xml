<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".homeactivity">
    <FrameLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:ignore="ExtraText">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="#76C043"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/menuIcon"
                android:layout_width="40dp"
                android:layout_height="440dp"
                android:layout_weight="0"
                android:padding="2dp"
                android:clickable="true"
                android:contentDescription="@string/welcome"
                android:src="@drawable/baseline_dehaze_24"
                tools:ignore="TouchTargetSizeCheck" />

            <TextView
                android:id="@+id/Pagename"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Home"
                android:textAlignment="center"
                android:textColor="@android:color/black"
                android:textSize="20sp" />

            <ImageView
                android:id="@+id/back_btn"
                android:layout_width="40dp"
                android:layout_height="40dp"

                android:background="@drawable/ic_back"
                android:clickable="true"

                android:contentDescription="@string/action_sign_in"
                app:layout_constraintBottom_toTopOf="@+id/bottomNavigationView"
                app:layout_constraintEnd_toEndOf="@+id/topAppBar"
                app:layout_constraintHorizontal_bias="0.01"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.008"
                tools:ignore="TouchTargetSizeCheck" />

        </LinearLayout>


        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="548dp"
            android:layout_marginTop="54dp"
            android:orientation="vertical">





        </FrameLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton

            android:id="@+id/fab_add"

            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginLeft="250dp"
            android:layout_marginTop="520dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_add"
            app:backgroundTint="@color/white"
            app:maxImageSize="37dp"
            tools:ignore="TouchTargetSizeCheck" />



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="600dp"
            android:background="#76C043"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/backhome"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="@string/prompt_email"
                android:padding="20dp"
                android:src="@drawable/home" />

            <ImageView
                android:id="@+id/dashboard"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_marginLeft="15dp"
                android:layout_weight="1"
                android:clickable="true"
                android:padding="20dp"
                android:src="@drawable/ic_grid"
                tools:ignore="SpeakableTextPresentCheck" />


            <FrameLayout
                android:layout_width="130dp"
                android:layout_height="wrap_content">

                <!-- Cart Icon -->

                <!-- Badge Text -->
                <ImageView
                    android:id="@+id/ic_cart"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_gravity="left"
                    android:layout_marginLeft="40dp"
                    android:layout_marginTop="-10dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:contentDescription="@string/app_name"
                    android:padding="20dp"
                    android:src="@drawable/ic_cart">

                </ImageView>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/cartBadge"
                    android:layout_width="40dp"
                    android:layout_height="48dp"
                    android:layout_gravity="top|end"
                    android:backgroundTint="@android:color/holo_red_dark"
                    android:backgroundTintMode="src_atop"
                    android:drawableLeft="@null"
                    android:drawableRight="@null"
                    android:drawablePadding="4dp"
                    android:gravity="left"
                    android:includeFontPadding="false"
                    android:minWidth="16dp"
                    android:padding="2dp"
                    android:textColor="@android:color/holo_red_dark"
                    android:textSize="15dp"
                    android:textStyle="bold"
                    tools:ignore="MissingConstraints,TextSizeCheck" />


            </FrameLayout>

            <FrameLayout
                android:id="@+id/edit_fragment_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"/>


        </LinearLayout>


    </FrameLayout>
    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>