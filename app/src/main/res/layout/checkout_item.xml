<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cart_items_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/product_corner"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Example Cart Item -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="4dp">

        <ImageView
            android:id="@+id/checkout_image"
            android:layout_width="1dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:src="@drawable/logo" />

        <TextView
            android:id="@+id/product_name"
            android:text="Product Name"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#000000"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/decrease"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/minus"
                app:tint="#D32F2F" />

            <TextView
                android:id="@+id/total_quantity"
                android:text=""
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp" />

            <ImageView
                android:id="@+id/increace"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:clickable="true"
                android:contentDescription="@string/action_sign_in_short"
                android:src="@drawable/ic_add_circle"
                app:tint="#33C458"
                tools:ignore="TouchTargetSizeCheck" />
        </LinearLayout>

        <TextView
            android:id="@+id/price"
            android:text="₱60.00"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/total_price"
            android:text="₱60.00"
            android:textColor="#1E88E5"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />

        <ImageView
            android:id="@+id/delete"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:clickable="true"
            android:contentDescription="@string/action_sign_in"
            android:src="@drawable/ic_delete_24"
            app:tint="#D32F2F"
            tools:ignore="TouchTargetSizeCheck" />
    </LinearLayout>






</LinearLayout>